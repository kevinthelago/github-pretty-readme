# github-pretty-readme — environment configuration
#
# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# `npm start` / `npm run docs` load it via Node's --env-file=.env.
# Every variable below is optional unless noted; the server still boots without
# them, but the corresponding feature is disabled until its keys are present.

# --- AI (Google Gemini) -----------------------------------------------------
# Required for AI features (account summaries, rating insights, repo analysis).
GOOGLE_AI_STUDIO_KEY=your-gemini-api-key
# Optional prompt template; `{topics}` is substituted at runtime. Has a default.
AI_PROMPT=

# --- GitHub -----------------------------------------------------------------
# Personal Access Token used as a fallback for unauthenticated GitHub API
# access. Recommended so SVG/data endpoints work without a user session.
GITHUB_TOKEN=ghp_your_personal_access_token
# GitHub OAuth App credentials (required for user authentication + apply flow).
GITHUB_APP_CLIENT_ID=your-oauth-app-client-id
GITHUB_APP_CLIENT_SECRET=your-oauth-app-client-secret

# --- Session ----------------------------------------------------------------
# Signing key for the cookie-session cookie. Has an insecure dev default;
# set a strong random value in any shared/production environment.
SESSION_SECRET=change-me-to-a-long-random-string
# Base URL for OAuth callbacks; must match your deployed app URL.
BASE_URL=http://localhost:8088
# Set to `production` to make session cookies secure (HTTPS-only).
NODE_ENV=development

# --- Server -----------------------------------------------------------------
# Port the Express server listens on (default 8088).
PORT=8088

# --- Rate limiting ----------------------------------------------------------
# In-memory limiter on the public SVG/AI endpoints (authenticated sessions are
# exempt). Window length in ms and max requests per client per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Set to `true` to disable rate limiting entirely.
RATE_LIMIT_DISABLED=false

# --- Monkeytype (optional integration) --------------------------------------
# Fallbacks used when a user has not connected Monkeytype in-session.
MONKEYTYPE_API_KEY=
MONKEYTYPE_USERNAME=

# --- WakaTime (optional integration) ----------------------------------------
# Fallback API key used when a user has not connected WakaTime in-session.
WAKATIME_API_KEY=

# --- Automation scripts (scripts/update-*.mjs) ------------------------------
# Token used by the profile-update automation to push to a profile repo.
# Only needed if you run the cron/automation scripts, not the web service.
PROFILE_REPO_TOKEN=
