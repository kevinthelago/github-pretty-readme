{
    "compilerOptions": {
        "checkJs": true,
        "strict": false,
        "noUnusedLocals": false,
        "moduleResolution": "node",
        "module": "ESNext",
        "target": "ES2022",
        "allowSyntheticDefaultImports": true
    },
    "include": ["src/**/*.js", "api/**/*.js", "express.js"],
    "exclude": ["node_modules", "public", "preview", "design"]
}
